{
  "name": "meteostat-webapp",
  "version": "1.3.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "vite --port 3333 --open",
    "build": "vite build && cp .htaccess dist/.htaccess",
    "preview": "npm run build && wrangler dev --port 8787",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc -p worker && vue-tsc --noEmit",
    "typecheck:worker": "tsc -p worker",
    "lint": "eslint . --fix",
    "prettier": "prettier --config ./.prettierrc --write \"src/**/*{.ts,.js,.json,.scss,.html,.vue}\"",
    "i18n-extract": "vue-i18n-extract report --vueFiles './src/**/*.?(js|vue)' --languageFiles './src/i18n/translations/*.json'"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/vue-fontawesome": "^3.3.3",
    "@popperjs/core": "^2.11.8",
    "@unhead/vue": "^3.4.3",
    "bootstrap": "^5.3.9",
    "chart.js": "^4.6.1",
    "chartjs-adapter-date-fns": "^3.0.0",
    "date-fns": "^4.4.0",
    "file-saver": "^2.0.5",
    "highlight.js": "^11.12.0",
    "leaflet": "^1.9.4",
    "leaflet-image": "^0.4.0",
    "papaparse": "^5.7.1",
    "pinia": "^4.1.0",
    "v-calendar": "^3.1.2",
    "vue": "^3.5.45",
    "vue-i18n": "^11.4.22",
    "vue-router": "^5.5.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261118.1",
    "@intlify/unplugin-vue-i18n": "^11.2.8",
    "@types/bootstrap": "^5.2.11",
    "@types/file-saver": "^2.0.7",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22",
    "@types/papaparse": "^5.5.2",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/eslint-config-typescript": "^14.9.0",
    "eslint": "^10.15.0",
    "eslint-plugin-vue": "^10.12.1",
    "prettier": "^3.10.1",
    "sass": "^1.108.2",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vue-i18n-extract": "^2.0.7",
    "vue-tsc": "^3.3.14",
    "wrangler": "^4.164.0"
  }
}
